PORT=8080

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173

# The frontend origin used to build activation links emailed to users.
FRONTEND_URL=http://localhost:5173

# Full service account JSON (as a single line string), or the same
# JSON base64-encoded. Never commit the real value — set this in
# Render's environment variable settings instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend (resend.com) API key used to send activation emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
