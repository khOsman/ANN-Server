PORT=8080

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173

# The frontend origin used to build activation links emailed to users.
FRONTEND_URL=http://localhost:5173

# Full service account JSON (as a single line string), or the same
# JSON base64-encoded. Never commit the real value — set this in
# Render's environment variable settings instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Brevo (brevo.com) transactional email API — used instead of raw SMTP
# because Render blocks outbound SMTP ports on this plan. BREVO_SENDER_EMAIL
# must be a verified sender in your Brevo account. Never commit the real
# API key — set it in Render's environment variable settings instead.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Amra Notun Network
